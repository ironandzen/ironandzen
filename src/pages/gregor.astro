---
import Layout from '../layouts/Layout.astro';
import '../styles/gregor.css';
---
<Layout
  title="Gerd Kschmand — Corporate Finance Advisory"
  description="Gerd Kschmand berät Unternehmen in Buchhaltung, Finanzstrategie, Nachfolge und M&A — präzise, verlässlich, lösungsorientiert."
>
  <div class="gk-page">

    <!-- ===== NAV ===== -->
    <nav class="gk-nav" id="gk-nav">
      <div class="gk-nav__inner">
        <a class="gk-brand" href="#top">
          <span class="gk-brand__mark">GK</span>
          Gerd Kschmand
        </a>
        <div class="gk-nav__links">
          <a href="#services">Services</a>
          <a href="#struktur">Struktur</a>
          <a href="#referenzen">Referenzen</a>
          <a href="#kontakt">Kontakt</a>
        </div>
        <div class="gk-nav__cta">
          <a class="gk-btn gk-btn--gold gk-btn--sm" href="#kontakt">Erstgespräch buchen</a>
          <button class="gk-burger" id="gk-burger" aria-label="Menü öffnen" aria-expanded="false">
            <span></span><span></span>
          </button>
        </div>
      </div>
    </nav>

    <button class="gk-mobile-close" id="gk-mobile-close" aria-label="Menü schließen">&times;</button>
    <div class="gk-mobile-panel" id="gk-mobile-panel">
      <a href="#services">Services</a>
      <a href="#struktur">Struktur</a>
      <a href="#referenzen">Referenzen</a>
      <a href="#kontakt">Kontakt</a>
      <a class="gk-btn gk-btn--gold" href="#kontakt" style="margin-top:20px;align-self:flex-start;">Erstgespräch buchen</a>
    </div>

    <main id="top">

      <!-- ===== HERO ===== -->
      <header class="gk-hero">
        <div class="gk-wrap gk-hero__grid">
          <div class="gk-reveal">
            <p class="gk-eyebrow">Corporate Finance Advisory</p>
            <h1 class="gk-h1">Gerd<br />Kschmand</h1>
            <p class="gk-lead">Entdecken Sie präzise Beratung und strategische Beratung, die Ihr Unternehmen voranbringen. Mit Gerd Kschmand als Partner für Ihr Unternehmen machen Sie fundierte Entscheidungen für nachhaltigen Erfolg.</p>
            <div class="gk-hero__cta">
              <a class="gk-btn gk-btn--primary" href="#services">Los geht&rsquo;s</a>
              <a class="gk-btn gk-btn--ghost" href="#kontakt">Kostenloses Erstgespräch</a>
            </div>
            <div class="gk-hero__meta">
              <div><b>Buchhaltung</b><span>Laufend &amp; präzise</span></div>
              <div><b>Beratung</b><span>Struktur &amp; Strategie</span></div>
              <div><b>Nachfolge &amp; M&amp;A</b><span>Diskret begleitet</span></div>
            </div>
          </div>

          <div class="gk-hero__art gk-reveal" aria-hidden="true">
            <svg viewBox="0 0 320 340" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="160" cy="170" r="150" stroke="#0e1c2b" stroke-opacity=".12" />
              <circle cx="160" cy="170" r="112" stroke="#a9812f" stroke-opacity=".35" />
              <circle cx="160" cy="170" r="74" fill="#0e1c2b" />
              <path d="M108 186 L134 150 L156 168 L196 118" stroke="#c4993f" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              <circle cx="196" cy="118" r="5" fill="#c4993f"/>
              <rect x="60" y="252" width="14" height="40" rx="2" fill="#0e1c2b" fill-opacity=".18"/>
              <rect x="82" y="234" width="14" height="58" rx="2" fill="#0e1c2b" fill-opacity=".3"/>
              <rect x="104" y="210" width="14" height="82" rx="2" fill="#a9812f"/>
              <rect x="126" y="222" width="14" height="70" rx="2" fill="#0e1c2b" fill-opacity=".3"/>
              <rect x="148" y="196" width="14" height="96" rx="2" fill="#0e1c2b" fill-opacity=".18"/>
            </svg>
          </div>
        </div>
      </header>

      <!-- ===== SERVICES (feature rows) ===== -->
      <section class="gk-section" id="services">
        <div class="gk-wrap">

          <div class="gk-feature-row">
            <div class="gk-feature-text gk-reveal">
              <p class="gk-eyebrow">Ihre Finanzen in besten Händen</p>
              <h2 class="gk-h2">Klarheit in Zahlen, Sicherheit in Entscheidungen</h2>
              <p class="gk-body">Buchhaltung, die Vertrauen schafft. Beratung, die Weitblick bietet. Gerd Kschmand ist Ihr verlässlicher Experte für Corporate Finance.</p>
            </div>
            <div class="gk-feature-art gk-reveal" aria-hidden="true">
              <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="20" y="14" width="60" height="72" rx="3" stroke="#faf7f1" stroke-opacity=".5" stroke-width="2"/>
                <line x1="30" y1="30" x2="70" y2="30" stroke="#c4993f" stroke-width="2"/>
                <line x1="30" y1="42" x2="62" y2="42" stroke="#faf7f1" stroke-opacity=".55" stroke-width="2"/>
                <line x1="30" y1="52" x2="66" y2="52" stroke="#faf7f1" stroke-opacity=".55" stroke-width="2"/>
                <line x1="30" y1="62" x2="58" y2="62" stroke="#faf7f1" stroke-opacity=".55" stroke-width="2"/>
                <circle cx="70" cy="72" r="12" fill="#c4993f"/>
                <path d="M65 72 L69 76 L76 68" stroke="#0e1c2b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
            </div>
          </div>

          <div class="gk-feature-row gk-feature-row--rev">
            <div class="gk-feature-text gk-reveal">
              <p class="gk-eyebrow">Mehr als nur Zahlen</p>
              <h2 class="gk-h2">Ihr Partner für Wachstum</h2>
              <p class="gk-body">Gerd Kschmand vereint Expertise und Engagement, um Ihre finanziellen Ziele zu erreichen. Für Unternehmen, die mehr wollen als nur Standardlösungen.</p>
            </div>
            <div class="gk-feature-art gk-reveal" aria-hidden="true">
              <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M15 78 L34 56 L50 68 L85 24" stroke="#c4993f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                <path d="M66 24 H85 V43" stroke="#c4993f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                <circle cx="15" cy="78" r="3.5" fill="#faf7f1"/>
                <circle cx="34" cy="56" r="3.5" fill="#faf7f1"/>
                <circle cx="50" cy="68" r="3.5" fill="#faf7f1"/>
                <circle cx="85" cy="24" r="4" fill="#c4993f"/>
                <line x1="15" y1="86" x2="85" y2="86" stroke="#faf7f1" stroke-opacity=".3" stroke-width="1.5"/>
              </svg>
            </div>
          </div>

        </div>
      </section>

      <!-- ===== STRUKTUR / PRICING ===== -->
      <section class="gk-section gk-section--soft" id="struktur">
        <div class="gk-wrap">
          <div class="gk-section__head gk-section__head--center gk-reveal">
            <p class="gk-eyebrow">Struktur</p>
            <h2 class="gk-h2">System und Strategie für Ihren Erfolg</h2>
            <p class="gk-lead" style="margin:0 auto;">Mit präziser Buchhaltung und Corporate-Finance-Beratung sorgt Gerd Kschmand für Stabilität und Wachstum — zuverlässig, klar und lösungsorientiert.</p>
          </div>

          <div class="gk-plans">

            <article class="gk-plan gk-reveal">
              <p class="gk-plan__name">Basic</p>
              <p class="gk-plan__price">250&nbsp;€ <span>/ Stunde</span></p>
              <ul class="gk-plan__list">
                <li><svg viewBox="0 0 20 20" fill="none"><path d="M4 10l4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Korrekte und übersichtliche Buchhaltung</li>
                <li><svg viewBox="0 0 20 20" fill="none"><path d="M4 10l4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Unterstützung bei der Erstellung von Monatsabschlüssen</li>
                <li><svg viewBox="0 0 20 20" fill="none"><path d="M4 10l4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Aufbereitung von Unterlagen für Steuerberater</li>
              </ul>
              <a class="gk-btn gk-btn--ghost" href="#kontakt">Anfragen</a>
            </article>

            <article class="gk-plan gk-plan--featured gk-reveal">
              <span class="gk-plan__badge">Empfohlen</span>
              <p class="gk-plan__name">Advanced-Beratung</p>
              <p class="gk-plan__price">480&nbsp;€ <span>/ 5 Stunden</span></p>
              <ul class="gk-plan__list">
                <li><svg viewBox="0 0 20 20" fill="none"><path d="M4 10l4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Analyse und Optimierung von Finanzstrukturen</li>
                <li><svg viewBox="0 0 20 20" fill="none"><path d="M4 10l4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Erstellung von Finanzplänen und Prognosen</li>
                <li><svg viewBox="0 0 20 20" fill="none"><path d="M4 10l4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Beratung zu steuerlichen Aspekten</li>
              </ul>
              <a class="gk-btn gk-btn--gold" href="#kontakt">Anfragen</a>
            </article>

            <article class="gk-plan gk-reveal">
              <p class="gk-plan__name">Premium-Strategie</p>
              <p class="gk-plan__price">890&nbsp;€ <span>/ 10 Stunden</span></p>
              <ul class="gk-plan__list">
                <li><svg viewBox="0 0 20 20" fill="none"><path d="M4 10l4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Analyse und Optimierung von Finanzstrukturen</li>
                <li><svg viewBox="0 0 20 20" fill="none"><path d="M4 10l4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Erstellung von Finanzplänen und Prognosen</li>
                <li><svg viewBox="0 0 20 20" fill="none"><path d="M4 10l4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Beratung zu steuerlichen Aspekten</li>
              </ul>
              <a class="gk-btn gk-btn--ghost" href="#kontakt">Anfragen</a>
            </article>

          </div>

          <div class="gk-plans-note gk-reveal">
            <a class="gk-btn gk-btn--primary" href="#kontakt">Kostenloses Erstgespräch buchen</a>
          </div>
        </div>
      </section>

      <!-- ===== BETREUUNG ===== -->
      <section class="gk-section" id="betreuung">
        <div class="gk-wrap gk-betreuung">
          <div class="gk-reveal">
            <p class="gk-eyebrow">Betreuung</p>
            <h2 class="gk-h2">Professionell und persönlich betreut</h2>
            <p class="gk-body">Von der Buchhaltung bis zur Finanzstrategie: Gerd Kschmand bringt Ordnung in Ihre Zahlenwelt und unterstützt Sie auf dem Weg zu fundierten Entscheidungen.</p>
            <div style="margin-top:28px;">
              <a class="gk-btn gk-btn--ghost" href="#referenzen">Mehr herausfinden</a>
            </div>
          </div>
          <div class="gk-timeline gk-reveal">
            <div class="gk-timeline__item">
              <span class="gk-timeline__dot">01</span>
              <div class="gk-timeline__body">
                <b>Bestandsaufnahme</b>
                <p>Gemeinsame Analyse Ihrer aktuellen Finanz- und Unternehmenssituation.</p>
              </div>
            </div>
            <div class="gk-timeline__item">
              <span class="gk-timeline__dot">02</span>
              <div class="gk-timeline__body">
                <b>Nachfolgeplanung</b>
                <p>Gerd Kschmand begleitet Sie bei der Planung und Umsetzung Ihrer Unternehmensnachfolge — mit klarem Blick für finanzielle, rechtliche und menschliche Aspekte.</p>
              </div>
            </div>
            <div class="gk-timeline__item">
              <span class="gk-timeline__dot">03</span>
              <div class="gk-timeline__body">
                <b>Übergabe</b>
                <p>So bleibt Ihr Lebenswerk in den richtigen Händen — strukturiert, steuerlich durchdacht, konfliktfrei.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== REFERENZEN ===== -->
      <section class="gk-section gk-section--soft" id="referenzen">
        <div class="gk-wrap">
          <div class="gk-section__head gk-reveal">
            <p class="gk-eyebrow">Referenzen</p>
            <h2 class="gk-h2">Aus der Praxis</h2>
          </div>

          <div class="gk-cases">
            <article class="gk-case gk-reveal">
              <span class="gk-case__num">01</span>
              <p class="gk-case__tag">M&amp;A</p>
              <h3 class="gk-h3">Erfolgreiche Fusion begleitet</h3>
              <p class="gk-case__body">Gerd Kschmand unterstützte ein mittelständisches Unternehmen bei der Übernahme eines Mitbewerbers. Von der detaillierten Due-Diligence-Prüfung bis zur Verhandlungsführung war er der zentrale Ansprechpartner. Nach der Übernahme entwickelte er einen Integrationsplan, der eine reibungslose Verschmelzung der beiden Firmen sicherstellte.</p>
              <a class="gk-case__link" href="#kontakt">Details anfragen <svg viewBox="0 0 20 20" fill="none"><path d="M4 10h12M12 6l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            </article>

            <article class="gk-case gk-reveal">
              <span class="gk-case__num">02</span>
              <p class="gk-case__tag">Nachfolgeberatung</p>
              <h3 class="gk-h3">Übergabe auf den Punkt gebracht</h3>
              <p class="gk-case__body">Ein familiengeführtes Unternehmen plante die Übergabe an die nächste Generation. Gerd Kschmand erarbeitete einen umfassenden Nachfolgeplan, der steuerliche Vorteile nutzte und die familiären Interessen in Einklang brachte — die Übergabe verlief konfliktfrei und effizient.</p>
              <a class="gk-case__link" href="#kontakt">Details anfragen <svg viewBox="0 0 20 20" fill="none"><path d="M4 10h12M12 6l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            </article>

            <article class="gk-case gk-reveal">
              <span class="gk-case__num">03</span>
              <p class="gk-case__tag">Steuerberatung</p>
              <h3 class="gk-h3">Sparpotenziale ausgeschöpft</h3>
              <p class="gk-case__body">Eine Wohnverwaltung stand vor der Herausforderung, steuerliche Abrechnungen rechtssicher und effizient zu gestalten. Gerd Kschmand analysierte die bestehenden Prozesse und zeigte konkrete Optimierungsmöglichkeiten auf — inklusive gesenkter Kosten und voll ausgeschöpfter steuerlicher Vorteile.</p>
              <a class="gk-case__link" href="#kontakt">Details anfragen <svg viewBox="0 0 20 20" fill="none"><path d="M4 10h12M12 6l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            </article>
          </div>
        </div>
      </section>

      <!-- ===== KONTAKT ===== -->
      <section class="gk-section" id="kontakt">
        <div class="gk-wrap">
          <div class="gk-kontakt gk-reveal">
            <div>
              <p class="gk-eyebrow">Kontakt</p>
              <h2 class="gk-h2">Bereit für den nächsten Schritt?</h2>
              <p class="gk-lead">Buchen Sie ein kostenloses Erstgespräch — unverbindlich und ohne Verpflichtung. Gerd Kschmand meldet sich innerhalb weniger Werktage persönlich zurück.</p>
            </div>

            <div id="gk-form-wrap">
              <form class="gk-form" id="gk-form">
                <div class="gk-field">
                  <label for="gk-name">Name</label>
                  <input id="gk-name" name="name" type="text" placeholder="Vor- &amp; Nachname" required />
                </div>
                <div class="gk-field">
                  <label for="gk-email">E-Mail</label>
                  <input id="gk-email" name="email" type="email" placeholder="sie@unternehmen.de" required />
                </div>
                <div class="gk-field">
                  <label for="gk-message">Nachricht</label>
                  <textarea id="gk-message" name="message" rows="3" placeholder="Worum geht es?"></textarea>
                </div>
                <button class="gk-btn gk-btn--on-dark" type="submit">Erstgespräch anfragen</button>
                <span class="gk-form__note">Ihre Daten werden vertraulich behandelt.</span>
              </form>
            </div>
            <p class="gk-form-done" id="gk-form-done" hidden>
              <svg viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4 10-10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Danke! Ihre Anfrage ist eingegangen — Sie hören in Kürze von uns.
            </p>
          </div>
        </div>
      </section>

    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="gk-footer">
      <div class="gk-wrap">
        <div class="gk-footer__inner">
          <a class="gk-brand" href="#top">
            <span class="gk-brand__mark">GK</span>
            Gerd Kschmand
          </a>
          <div class="gk-footer__links">
            <a href="#services">Services</a>
            <a href="#struktur">Struktur</a>
            <a href="#referenzen">Referenzen</a>
            <a href="#kontakt">Kontakt</a>
          </div>
        </div>
        <div class="gk-footer__meta">
          <span>© 2026 Gerd Kschmand · Corporate Finance Advisory</span>
          <a href="/">← Zurück zu Iron &amp; Zen</a>
        </div>
      </div>
    </footer>

  </div>

  <script>
    // Sticky nav shadow
    const nav = document.getElementById('gk-nav');
    const onScroll = () => {
      if (!nav) return;
      nav.classList.toggle('is-scrolled', window.scrollY > 8);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Mobile menu
    const burger = document.getElementById('gk-burger');
    const panel = document.getElementById('gk-mobile-panel');
    const closeBtn = document.getElementById('gk-mobile-close');
    function toggleMenu(open: boolean) {
      panel?.classList.toggle('is-open', open);
      closeBtn?.classList.toggle('is-open', open);
      burger?.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    }
    burger?.addEventListener('click', () => toggleMenu(!panel?.classList.contains('is-open')));
    closeBtn?.addEventListener('click', () => toggleMenu(false));
    panel?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => toggleMenu(false)));

    // Scroll reveal
    const reduced = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;
    const items = Array.from(document.querySelectorAll<HTMLElement>('.gk-reveal'));
    if (reduced) {
      items.forEach(el => el.classList.add('is-in'));
    } else {
      const io = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.14, rootMargin: '0px 0px -60px 0px' });
      items.forEach(el => io.observe(el));
    }

    // Contact form (client-side only — no backend wired up)
    document.getElementById('gk-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      (document.getElementById('gk-form-wrap') as HTMLElement).style.display = 'none';
      (document.getElementById('gk-form-done') as HTMLElement).hidden = false;
    });
  </script>
</Layout>
