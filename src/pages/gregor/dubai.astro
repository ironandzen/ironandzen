      'k3.b': 'Reviewed daily, never audited, and presented to everyone unasked.',
      'k4.t': 'Excuses are liabilities.',
      'k4.b': 'They accrue interest, they eventually fall due, and only one person can settle them.',
      'k5.t': 'Discipline is compound interest.',
      'k5.b': 'The one metaphor he kept from accounting. He uses it daily.',
      'k6.t': 'Never back to winter.',
      'k6.b': 'Neither climatically nor characterologically. Germany is referenced exclusively in the past tense.',

      'v.eyebrow': 'Voices',
      'v.title': 'What participants say',
      'q1': '&ldquo;I arrived with a limited company and left with a holding structure. I had actually just asked for the Wi-Fi password.&rdquo;',
      'q1.role': 'Level 1 · 29',
      'q2': '&ldquo;Gerd did not teach me to sell. He taught me to stop begging. That was more expensive, but more honest.&rdquo;',
      'q2.role': 'Level 2 · 34',
      'q3': '&ldquo;Since the seminar I get up at 04:15. My wife does not. But that is her journey.&rdquo;',
      'q3.role': 'Level 3 · 41',

      'cta.eyebrow': 'Next date',
      'cta.title': 'The seat costs nothing.<br />The decision does.',
      'cta.lead': 'Apply in 90 seconds. Answer within 48 hours. Instant rejection if you ask about instalments.',
      'cta.btn': 'Apply now',
      'cta.note': 'The form lives on the main page — even a Chad only needs one contact form.',

      'foot.back': '← Back to the serious version',
      'foot.disclaimer': '<b>Satire.</b> This page is a parody of the German-language Dubai and sales-seminar genre. All people, seminars, quotes and figures are invented. There is no affiliation with, or endorsement by, any real seminar provider, trainer or event organiser.',
    };

    const TITLES: Record<string, string> = {
      de: 'Gerd Kschmand — Dubai Era | Der ultimative Chad',
      en: 'Gerd Kschmand — Dubai Era | The Ultimate Chad',
    };

    const i18nNodes = Array.from(document.querySelectorAll<HTMLElement>('[data-i18n]'));
    const DE = new Map<HTMLElement, string>();
    i18nNodes.forEach(n => DE.set(n, n.innerHTML));

    const langButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('#dxb-lang button')
    );

    function setLang(lang: string) {
      for (const node of i18nNodes) {
        const key = node.dataset.i18n;
        if (!key) continue;
        const next = lang === 'en' ? EN[key] : DE.get(node);
        if (typeof next === 'string') node.innerHTML = next;
      }
      document.documentElement.lang = lang;
      document.title = TITLES[lang] ?? document.title;
      for (const btn of langButtons) {
        const active = btn.dataset.lang === lang;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', String(active));
      }
      try { localStorage.setItem('gk-dubai-lang', lang); } catch {}
    }

    for (const btn of langButtons) {
      btn.addEventListener('click', () => setLang(btn.dataset.lang ?? 'de'));
    }

    let saved = 'de';
    try { saved = localStorage.getItem('gk-dubai-lang') ?? 'de'; } catch {}
    setLang(saved === 'en' ? 'en' : 'de');
  </script>
</Layout>
