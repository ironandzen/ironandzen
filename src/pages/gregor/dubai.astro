  <script>
    // ── Sticky nav ────────────────────────────────────────────
    const nav = document.getElementById('dxb-nav');
    const onScroll = () => nav?.classList.toggle('is-scrolled', window.scrollY > 8);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // ── Scroll reveal ─────────────────────────────────────────
    const reduced = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;
    const revealItems = Array.from(document.querySelectorAll<HTMLElement>('.dxb-reveal'));
    if (reduced) {
      revealItems.forEach(el => el.classList.add('is-in'));
    } else {
      const io = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
      revealItems.forEach(el => io.observe(el));
    }

    // ── Language toggle (DE default, EN on demand) ────────────
    // Values are trusted static strings authored here, so innerHTML is safe
    // and lets translations carry <br>, <em> and <b>.
    const EN: Record<string, string> = {
      'nav.day': 'The Day',
      'nav.seminars': 'Seminars',
      'nav.code': 'The Code',
      'nav.voices': 'Voices',
      'nav.cta': 'Claim a seat',

      'hero.tag': '<i></i> Dubai Marina · 26 °C · No way back',
      'hero.title': 'The ultimate<br /><em>Chad</em>',
      'hero.lead': 'Gerd Kschmand never gave up accounting. He simply moved it to 04:15, into a time zone with better weather and a flatter tax curve. Welcome to the Dubai era.',
      'hero.cta1': 'View seminars',
      'hero.cta2': 'To the serious version',

      'stat.wake': 'Wake-up time',
      'stat.excuses': 'Excuses',
      'stat.sun': 'Days of sun',
      'stat.seminars': 'Seminars / year',

      'move.eyebrow': 'The Relocation',
      'move.title': 'From balance sheet to main stage',
      'move.p1': 'At some point the German accounting code stopped working as a personality. Gerd sold the estate car, kept the calculator and booked a one-way ticket — hand luggage only, because a Chad does not wait at baggage claim.',
      'move.p2': 'Today he explains VAT filings from the 34th floor, overlooking a skyline built exactly like his upper body: fast, expensive and against all advice.',

      'day.eyebrow': 'The Day',
      'day.title': '24 hours, 19 of them productive',
      'day.lead': 'No two days are alike. Except the structure. And breakfast. And training. And the time.',
      'd1.t': 'Up before the alarm',
      'd1.b': 'The alarm clock still sits there. Out of respect. It is never needed, but it knows who is in charge.',
      'd2.t': 'Ice bath',
      'd2.b': 'In Dubai the ice has to be flown in. Gerd pays for that. Not because it makes sense, but because it is uncomfortable.',
      'd3.t': 'Push Day',
      'd3.b': 'It is always push day. Pull day was invented by people who settle for less. Between sets he answers voice notes at a volume that coaches the entire gym.',
      'd4.t': 'Cash flow on the balcony',
      'd4.b': 'Black coffee, black numbers. The view costs more than his first car, but it pays for itself — he says, while calculating it.',
      'd5.t': 'Lunch',
      'd5.b': 'Steak. Side dish: a second steak. Carbohydrates are for people with nothing planned.',
      'd6.t': 'Stage. Headset. 400 chairs.',
      'd6.b': 'No script, no slides, no break. After 90 minutes half the room is standing. After 120 minutes half the room is standing at the sales desk. That is how the genre works.',
      'd7.t': 'Journaling',
      'd7.b': 'Three things he is grateful for. All three are KPIs.',
      'd8.t': 'Lights out',
      'd8.b': 'Six hours and 45 minutes of sleep. Optimised, tracked, documented. He dreams in English, it sounds more international.',

      'sem.eyebrow': 'The Seminars',
      'sem.title': 'Three days that will not change your numbers — but your presence',
      'sem.lead': 'Stage, headset, desert. The full dramaturgy of the German sales circuit, exported to a time zone without winter.',
      's1.tag': 'Level 1',
      's1.t': 'Closer Code',
      's1.b': 'Closing is not an event, it is a character trait. Three days on why &ldquo;I&rsquo;ll think about it&rdquo; is a complete sentence — just not yours.',
      's1.m1': '3 days',
      's1.m3': '400 seats',
      's2.tag': 'Level 2',
      's2.t': 'Mindset Offensive',
      's2.b': 'Two nights in the desert, no signal, no comfort. On the second morning somebody cries. On the third, that same person buys level 3.',
      's2.m1': '2 nights',
      's2.m3': '60 seats',
      's3.tag': 'Level 3',
      's3.b': 'Balance sheets in the morning, pull-ups in the afternoon. The only training where you sign off on both your equity ratio and your body fat percentage.',
      's3.m1': '5 days',
      's3.m3': '24 seats',

      'code.eyebrow': 'The Code',
      'code.title': 'Six rules, zero negotiation',
      'k1.t': 'No alcohol. Only ambition.',
      'k1.b': 'Exceptions apply at company parties only, and he does not throw any.',
      'k2.t': 'Explain yourself and you stop selling.',
      'k2.b': 'State the price, never justify it. Then stay silent. For minutes, if necessary.',
